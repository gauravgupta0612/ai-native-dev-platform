<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- groupId follows JitPack's convention so the library can be used straight from GitHub:
       com.github.gauravgupta0612:ai-native-common:<git tag> -->
  <groupId>com.github.gauravgupta0612</groupId>
  <artifactId>ai-native-common</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>
  <name>AI-Native Common (Java)</name>
  <description>Secure, zero-dependency building blocks for AI apps: multi-model router, agent runtime, validated tools, sandboxed file tools, guardrails and a tamper-evident audit log.</description>
  <url>https://github.com/gauravgupta0612/ai-native-dev-platform</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>gauravgupta0612</id>
      <url>https://github.com/gauravgupta0612</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/gauravgupta0612/ai-native-dev-platform</url>
    <connection>scm:git:https://github.com/gauravgupta0612/ai-native-dev-platform.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
  </properties>

  <dependencies>
    <!-- test only; the library itself has no dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <!-- publishes a -sources.jar so IDEs show the code and docs -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <excludes>
            <exclude>com/ainative/common/examples/**</exclude>
          </excludes>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>com.ainative.common</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>com.ainative.common.examples.BasicAgentExample</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
